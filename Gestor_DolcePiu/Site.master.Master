<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.master.cs" Inherits="Gestor_DolcePiu.Site_master" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Dolce Piu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">
                    <img src="/Recursos/img/logo_dolcepiu.png" alt="Logo" width="50" height="50" class="d-inline-block align-text-top">
                </a>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/Nosotros.aspx">Nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/Contacto.aspx">Contacto</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Pages/Comprar.aspx">Como comprar</a>
                        </li>
                    </ul>
                </div>
                <div>
                    <a class="btn btn-primary btn-sm" href="/Pages/Login.aspx">Iniciar sesion</a>
                    <a class="btn btn-warning btn-sm" href="/Pages/Registro.aspx">Crear cuenta</a>
                </div>
            </div>
        </nav>
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>
